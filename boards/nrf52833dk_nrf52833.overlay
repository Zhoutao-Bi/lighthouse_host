/ {
	leds {
		user_led: led_user {
			gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
			label = "User LED";
		};
	};

	aliases {
		my-led = &user_led;
	};

	ts4231_n1: ts4231_n1 {
		compatible = "lighthouse_robot,ts4231";
		e-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		d-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		label = "TS4231 N1";
	};

	ts4231_n2: ts4231_n2 {
		compatible = "lighthouse_robot,ts4231";
		e-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		d-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		label = "TS4231 N2";
	};

	ts4231_n3: ts4231_n3 {
		compatible = "lighthouse_robot,ts4231";
		e-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		d-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
		label = "TS4231 N3";
	};

	chosen {
		/* Disable any chosen bindings the board DTS sets on uart0.
		 * UART0 is dedicated to the pose text stream; console / shell /
		 * bt-monitor / bt-c2h / mcumgr-uart must not mux onto it.
		 */
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
		/delete-property/ zephyr,uart-mcumgr;
		/delete-property/ zephyr,bt-mon-uart;
		/delete-property/ zephyr,bt-c2h-uart;
	};
};

/* Remap UART0 to P0.28 (TXD) / P0.29 (RXD) for the user's custom board.
 * Default DK pinout (P0.06/P0.08 for virtual COM) is overridden here.
 * SWD / flashing pins are unaffected — only the UART0 peripheral's PSEL.
 * Note: the board DTS already binds &uart0's pinctrl-0 to &uart0_default,
 * so redefining the labeled node below is sufficient — no &uart0 edits needed.
 * group1 keeps TX (active), group2 keeps RX (was P0.08 + CTS P0.07 with bias-pull-up,
 * which would otherwise leak through from the merged board DTS).
 */
&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 28)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 29)>;
			/delete-property/ bias-pull-up;
		};
	};
};
